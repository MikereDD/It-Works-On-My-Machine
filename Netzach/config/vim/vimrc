" =============================================================================
" Typezero Vim Configuration - Windows
" =============================================================================
" Main config: ~/config/vim/vimrc
" Author:      Mike Redd / typezero
" Platform:    Windows Vim / gVim port of the Pi 5 Arch configuration
" Version:     3.5-win - expanded navigation, alignment, project, and focus tooling
"
" Design goals:
"   - Keep the Windows and Arch configurations conceptually aligned.
"   - Preserve native Vim behavior unless a mapping/plugin adds clear value.
"   - Favor discoverable leader mappings over hard-to-remember command names.
"   - Keep persistent state, sessions, backups, swap, and undo data out of the
"     working tree.
"   - Make terminal paste behavior predictable and safe for large code blocks.
"
" Loader note:
"   ~/_vimrc is only a loader stub. Because of that, $MYVIMRC points to the
"   loader rather than this file. Self-edit, reload, and auto-source logic must
"   therefore use g:vim_main explicitly.
"
" Windows layout (mirrors the Linux ~/.config/vim + ~/.vim split):
"   config + runtime data       -> ~/config/vim/
"   plugins + plug.vim autoload -> ~/vimfiles/   (Windows default runtimepath)
"
" Convention:
"   [win] comments mark intentional differences from the Linux configuration.
"   <leader> is comma (,) and <localleader> is backslash (\).
" =============================================================================

scriptencoding utf-8
set encoding=utf-8              " [win] force UTF-8 so glyphs/listchars render
set nocompatible
filetype plugin indent on
syntax on

let mapleader = ","
let maplocalleader = "\\"

" -------------------------
" Paths (Windows)
" -------------------------
" [win] Normalize backslashes to forward slashes so paths are safe in
" option values and patterns even if the profile path has odd characters.
function! s:Slash(p) abort
  return substitute(a:p, '\\', '/', 'g')
endfunction

let g:vim_config_dir  = s:Slash(expand('~/config/vim'))   " this file + data
let g:vim_rt_dir      = s:Slash(expand('~/vimfiles'))     " plugins (in rtp)
let g:vim_main        = g:vim_config_dir . '/vimrc'        " THIS file
let g:vim_backup_dir  = g:vim_config_dir . '/backup'
let g:vim_swap_dir    = g:vim_config_dir . '/swap'
let g:vim_undo_dir    = g:vim_config_dir . '/undo'
let g:vim_info_file   = g:vim_config_dir . '/viminfo'
let g:vim_session_dir = g:vim_config_dir . '/session'
let g:vim_plug_dir    = g:vim_rt_dir . '/plugged'

for s:dir in [g:vim_config_dir, g:vim_rt_dir, g:vim_backup_dir,
            \ g:vim_swap_dir, g:vim_undo_dir, g:vim_session_dir]
  if !isdirectory(s:dir)
    call mkdir(s:dir, 'p', 0700)
  endif
endfor

" -------------------------
" vim-plug auto-bootstrap
" -------------------------
" [win] plug.vim must live in an autoload dir on the runtimepath; ~/vimfiles
" is on Windows Vim's default rtp, so the plugin tree goes there. curl ships
" with Win10 1803+. If curl is absent, drop plug.vim in ~/vimfiles/autoload/.
let s:plug_path = g:vim_rt_dir . '/autoload/plug.vim'
if empty(glob(s:plug_path))
  silent execute '!curl -fLo ' . shellescape(s:plug_path) . ' --create-dirs '
        \ . 'https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim'
  autocmd VimEnter * PlugInstall --sync | source g:vim_main
endif

