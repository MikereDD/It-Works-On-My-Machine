" -------------------------
" Line Numbers
" -------------------------
" Start with absolute numbers. ,nu cycles:
"   absolute -> off -> absolute + relative -> absolute ...
set number
set norelativenumber
function! ToggleNumbers()
  if &relativenumber
    setlocal norelativenumber
  elseif &number
    setlocal nonumber
  else
    setlocal number relativenumber
  endif
endfunction
nnoremap <leader>nu :call ToggleNumbers()<CR>

