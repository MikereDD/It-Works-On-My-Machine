" [win] Re-source on save. Compared against g:vim_main (this file) rather than
" $MYVIMRC, since with a loader $MYVIMRC is the loader. Case-insensitive and
" slash-normalized so it matches regardless of how Windows reports the path.
function! s:SourceIfMainVimrc() abort
  if s:Slash(expand('<afile>:p')) ==? g:vim_main
    execute 'source ' . fnameescape(g:vim_main)
  endif
endfunction
augroup vimrc_auto_source
  autocmd!
  autocmd BufWritePost * call s:SourceIfMainVimrc()
augroup END

augroup auto_mkdir
  autocmd!
  autocmd BufWritePre * call mkdir(expand('<afile>:p:h'), 'p')
augroup END

