" -------------------------
" System clipboard integration / reliable paste
" -------------------------
" [win] On Windows + and * refer to the same system clipboard.
if has('clipboard')
  set clipboard=unnamed

  " Exact clipboard paste in Normal mode. These bypass Insert-mode
  " autoindent, mappings, and abbreviations, so large code blocks retain
  " their original whitespace.
  nnoremap <silent> <leader>p "+p
  nnoremap <silent> <leader>P "+P

  " Replace a visual selection without overwriting the clipboard.
  xnoremap <silent> <leader>p "_d"+P
  xnoremap <silent> <leader>P "_d"+P

  " Insert the clipboard literally at the cursor while already in Insert
  " mode. <C-r><C-o> prevents indentation and mapping side effects.
  inoremap <silent> <C-S-v> <C-r><C-o>+
  cnoremap <silent> <C-S-v> <C-r>+
endif

" Manual paste-mode fallback for terminals that do not report bracketed
" paste correctly. F2 toggles it; leaving Insert mode always turns it off.
set pastetoggle=<F2>
set nopaste
augroup safe_paste_mode
  autocmd!
  autocmd InsertLeave * if &paste | set nopaste | echo "paste mode: off" | endif
augroup END

" Show the current paste-mode state without changing it.
nnoremap <silent> <leader>ps :set paste?<CR>

" -------------------------
" Quick save/quit (buffer-aware)
" -------------------------
" ,w writes only when changed; ,q closes the window; ,Q deletes the buffer.
" ,bq closes the current buffer while returning to the previous one.
" ,z keeps only the current split; ,= reindents the entire file and restores
" the cursor position afterward.
nnoremap <leader>w :update<CR>
nnoremap <leader>q :quit<CR>
nnoremap <leader>Q :bdelete<CR>
nnoremap <leader>bq :bprevious <bar> bdelete #<CR>
nnoremap <leader>z <C-w>o
nnoremap <leader>= mzgg=G`z
vnoremap = =gv
nnoremap g. `.
nnoremap g, `^

" -------------------------
" Typo Fixes
" -------------------------
command! -bang -nargs=* W w<bang> <args>
command! -bang -nargs=* Wq wq<bang> <args>
command! -bang -nargs=* WQ wq<bang> <args>
command! -bang Q q<bang>
command! -bang Qa qa<bang>
command! -bang QA qa<bang>

" -------------------------
" Large File Handling
" -------------------------
" Files over 1 MiB trade persistence and expensive FileType processing for
" responsiveness. bufhidden=unload also releases the buffer when abandoned.
augroup large_file
  autocmd!
  autocmd BufReadPre * if getfsize(expand("%")) > 1024*1024 |
        \ setlocal noswapfile |
        \ setlocal noundofile |
        \ setlocal eventignore+=FileType |
        \ setlocal bufhidden=unload |
        \ endif
augroup END
