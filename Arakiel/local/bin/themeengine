#!/usr/bin/env bash
set -euo pipefail

DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/typezero/themeengine"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/typezero/themeengine"
THEMES_DIR="$DATA_HOME/themes"
TEMPLATES_DIR="$DATA_HOME/templates"
CURRENT_FILE="$CONFIG_HOME/current-theme"
PREVIOUS_FILE="$CONFIG_HOME/previous-theme"

mkdir -p "$DATA_HOME" "$CONFIG_HOME"

die() { printf 'themeengine: %s\n' "$*" >&2; exit 1; }

strip_quotes() {
    local v="$1"
    if [[ "$v" == \"*\" && "$v" == *\" ]]; then
        v="${v:1:${#v}-2}"
    elif [[ "$v" == \'*\' && "$v" == *\' ]]; then
        v="${v:1:${#v}-2}"
    fi
    printf '%s' "$v"
}

declare -A T=()

load_theme() {
    local id="$1"
    local file="$THEMES_DIR/$id/theme.conf"
    [[ -f "$file" ]] || die "theme not found: $id"

    T=()
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%$'\r'}"
        [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
        [[ "$line" == *=* ]] || continue
        local key="${line%%=*}"
        local value="${line#*=}"
        key="${key//[[:space:]]/}"
        value="$(strip_quotes "$value")"
        T["$key"]="$value"
    done < "$file"
}

render() {
    local src="$1" dst="$2"
    cp "$src" "$dst"
    local key val escaped
    for key in "${!T[@]}"; do
        val="${T[$key]}"
        escaped="${val//&/\\&}"
        escaped="${escaped//|/\\|}"
        sed -i "s|{{${key}}}|${escaped}|g" "$dst"
    done
}

hex_rgb() {
    local h="${1#\#}"
    printf '%d;%d;%d' "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}"
}

write_shell_theme() {
    local out="$CONFIG_HOME/current.sh"
    local accent success warning error secondary info text muted bright
    accent="$(hex_rgb "${T[ACCENT]}")"
    success="$(hex_rgb "${T[SUCCESS]}")"
    warning="$(hex_rgb "${T[WARNING]}")"
    error="$(hex_rgb "${T[ERROR]}")"
    secondary="$(hex_rgb "${T[SECONDARY]}")"
    info="$(hex_rgb "${T[INFO]}")"
    text="$(hex_rgb "${T[TEXT]}")"
    muted="$(hex_rgb "${T[MUTED]}")"
    bright="$(hex_rgb "${T[BRIGHT]}")"

    cat > "$out" <<EOF
# Generated by Typezero ThemeEngine — ${T[THEME_NAME]}
TE_THEME_ID='${T[THEME_ID]}'
TE_THEME_NAME='${T[THEME_NAME]}'
TE_BG='${T[BG]}'
TE_SURFACE='${T[SURFACE]}'
TE_BORDER='${T[BORDER]}'
TE_TEXT='${T[TEXT]}'
TE_ACCENT='${T[ACCENT]}'

if [[ -t 1 ]]; then
    UI_CYN=\$'\\e[38;2;${accent}m'
    UI_GRN=\$'\\e[38;2;${success}m'
    UI_YLW=\$'\\e[38;2;${warning}m'
    UI_RED=\$'\\e[38;2;${error}m'
    UI_MAG=\$'\\e[38;2;${secondary}m'
    UI_WHT=\$'\\e[38;2;${bright}m'
    UI_GRY=\$'\\e[38;2;${muted}m'
    UI_INFO=\$'\\e[38;2;${info}m'
    UI_TEXT=\$'\\e[38;2;${text}m'
    UI_DIM=\$'\\e[2m'
    UI_RST=\$'\\e[0m'
else
    UI_CYN=''; UI_GRN=''; UI_YLW=''; UI_RED=''; UI_MAG=''
    UI_WHT=''; UI_GRY=''; UI_INFO=''; UI_TEXT=''; UI_DIM=''; UI_RST=''
fi
UI_R="\$UI_RST"
EOF
}

reload_runtime() {
    [[ "${THEMEENGINE_NO_RELOAD:-0}" == "1" ]] && return 0

    local display="${DISPLAY:-:0}"
    local xauth="${XAUTHORITY:-$HOME/.Xauthority}"

    if command -v xrdb >/dev/null 2>&1 && [[ -f "$HOME/.Xresources.theme" ]]; then
        DISPLAY="$display" XAUTHORITY="$xauth" xrdb -merge "$HOME/.Xresources.theme" >/dev/null 2>&1 || true
    fi

    if command -v tmux >/dev/null 2>&1 && tmux list-sessions >/dev/null 2>&1; then
        tmux source-file "$HOME/.config/tmux/theme.conf" >/dev/null 2>&1 || true
    fi

    pkill -x i3blocks >/dev/null 2>&1 || true
    # Theme application regenerates i3's included theme configuration and
    # i3blocks resources. Re-exec i3 after applying them so the graphical
    # session immediately reflects the new theme without requiring the user
    # to invoke the normal Mod+Shift+R restart manually.
    #
    # i3 restart preserves the running session and window layout while
    # replacing the window manager process with the newly configured one.
    if command -v i3-msg >/dev/null 2>&1; then
        DISPLAY="$display" XAUTHORITY="$xauth" i3-msg restart >/dev/null 2>&1 || true
    fi
}

apply_theme() {
    local id="$1" remember="${2:-yes}"
    load_theme "$id"

    if [[ "$remember" == yes && -f "$CURRENT_FILE" ]]; then
        local old
        old="$(<"$CURRENT_FILE")"
        [[ "$old" != "$id" ]] && printf '%s\n' "$old" > "$PREVIOUS_FILE"
    fi

    mkdir -p "$HOME/.config/i3" "$HOME/.config/tmux"

    render "$TEMPLATES_DIR/arakiel/i3-theme.conf.tpl" "$HOME/.config/i3/theme.conf"
    render "$TEMPLATES_DIR/arakiel/i3blocks.conf.tpl" "$HOME/.config/i3/i3blocks.conf"
    render "$TEMPLATES_DIR/arakiel/Xresources.tpl" "$HOME/.Xresources.theme"
    render "$TEMPLATES_DIR/arakiel/tmux.conf.tpl" "$HOME/.config/tmux/theme.conf"

    # Vim consumes the same semantic palette as the desktop, terminal, tmux,
    # and shell. Keep the generated colorscheme inside Vim's existing config
    # tree so ThemeEngine does not introduce a second Vim runtime location.
    mkdir -p "$HOME/.config/vim/colors"
    render "$TEMPLATES_DIR/shared/vim-colors.vim.tpl" \
        "$HOME/.config/vim/colors/typezero.vim"

    write_shell_theme

    printf '%s\n' "$id" > "$CURRENT_FILE"
    reload_runtime
    printf 'Applied theme: %s\n' "${T[THEME_NAME]}"
}

cmd_bootstrap() {
    local repo="${1:-$PWD}"
    [[ -d "$repo/ThemeEngine/themes" ]] || die "ThemeEngine/themes not found under: $repo"
    rm -rf "$THEMES_DIR" "$TEMPLATES_DIR"
    mkdir -p "$THEMES_DIR" "$TEMPLATES_DIR"
    cp -a "$repo/ThemeEngine/themes/." "$THEMES_DIR/"
    cp -a "$repo/ThemeEngine/templates/." "$TEMPLATES_DIR/"
    printf 'ThemeEngine data installed under %s\n' "$DATA_HOME"
}

cmd_list() {
    [[ -d "$THEMES_DIR" ]] || die "no themes installed; run: themeengine bootstrap <repo-root>"
    local d id
    for d in "$THEMES_DIR"/*; do
        [[ -d "$d" ]] || continue
        id="${d##*/}"
        if [[ -f "$CURRENT_FILE" && "$(<"$CURRENT_FILE")" == "$id" ]]; then
            printf '* %s\n' "$id"
        else
            printf '  %s\n' "$id"
        fi
    done
}

cmd_current() {
    [[ -f "$CURRENT_FILE" ]] && cat "$CURRENT_FILE" || printf 'none\n'
}

cmd_preview() {
    local id="${1:-}"
    [[ -n "$id" ]] || id="$([[ -f "$CURRENT_FILE" ]] && cat "$CURRENT_FILE" || true)"
    [[ -n "$id" ]] || die "no theme selected"
    load_theme "$id"

    printf '\n  %s\n\n' "${T[THEME_NAME]}"
    local key rgb
    for key in ACCENT ACCENT_BRIGHT TEXT MUTED SUCCESS WARNING ERROR SECONDARY INFO; do
        rgb="$(hex_rgb "${T[$key]}")"
        printf '\e[38;2;%sm  %-14s %s\e[0m\n' "$rgb" "$key" "${T[$key]}"
    done
    printf '\n'
}

cmd_doctor() {
    printf 'ThemeEngine doctor\n\n'
    printf '  themes        %s\n' "$([[ -d "$THEMES_DIR" ]] && echo PASS || echo MISSING)"
    printf '  templates     %s\n' "$([[ -d "$TEMPLATES_DIR" ]] && echo PASS || echo MISSING)"
    printf '  current       %s\n' "$([[ -f "$CURRENT_FILE" ]] && cat "$CURRENT_FILE" || echo none)"

    local tool
    for tool in i3-msg i3blocks xrdb tmux fc-match; do
        printf '  %-13s %s\n' "$tool" "$(command -v "$tool" >/dev/null 2>&1 && echo PASS || echo MISSING)"
    done

    if [[ -f "$CURRENT_FILE" ]]; then
        load_theme "$(<"$CURRENT_FILE")"
        local match
        match="$(fc-match "${T[FONT_FAMILY]}:style=${T[FONT_STYLE]}" 2>/dev/null || true)"
        if [[ "$match" == *"${T[FONT_STYLE]}"* ]]; then
            printf '  font          PASS (%s)\n' "${T[FONT_FAMILY]} ${T[FONT_STYLE]}"
        else
            printf '  font          CHECK (%s)\n' "${T[FONT_FAMILY]} ${T[FONT_STYLE]}"
        fi
    fi
}

case "${1:-}" in
    bootstrap) shift; cmd_bootstrap "${1:-$PWD}" ;;
    list) cmd_list ;;
    current) cmd_current ;;
    preview) shift; cmd_preview "${1:-}" ;;
    apply) shift; [[ $# -ge 1 ]] || die "usage: themeengine apply <theme>"; apply_theme "$1" ;;
    reload)
        [[ -f "$CURRENT_FILE" ]] || die "no current theme"
        apply_theme "$(<"$CURRENT_FILE")" no
        ;;
    rollback)
        [[ -f "$PREVIOUS_FILE" ]] || die "no previous theme"
        prev="$(<"$PREVIOUS_FILE")"
        apply_theme "$prev"
        ;;
    doctor) cmd_doctor ;;
    *)
        cat <<'EOF'
Typezero ThemeEngine

usage:
  themeengine bootstrap [repo-root]
  themeengine list
  themeengine current
  themeengine preview [theme]
  themeengine apply <theme>
  themeengine reload
  themeengine rollback
  themeengine doctor
EOF
        ;;
esac
