#!/usr/bin/env zsh
#--------------------------------------------
# file:     ~/.zsh.d/motd
# author:   Mike Redd
# version:  3.0
# desc:     Zsh loader for the shared Arakiel SSH MOTD renderer
#--------------------------------------------

# Keep shell-specific startup files tiny. The renderer itself is shared with
# Bash so both shells render the same login banner from one implementation.
if [[ -r "$HOME/lib/motd.sh" ]]; then
    source "$HOME/lib/motd.sh"
fi
