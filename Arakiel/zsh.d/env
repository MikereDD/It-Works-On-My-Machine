#!/usr/bin/env zsh
#--------------------------------------------
# file:     ~/.zsh.d/env
# author:   Mike Redd
# version:  2.0
# desc:     Zsh loader for shared Arakiel environment defaults
#--------------------------------------------

if [[ -r "$HOME/lib/env.sh" ]]; then
    source "$HOME/lib/env.sh"
fi

# Zsh ties PATH to the $path array. Keep entries unique while preserving
# their first occurrence and therefore their search priority.
typeset -U path PATH
