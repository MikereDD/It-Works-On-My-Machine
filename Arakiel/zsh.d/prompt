#!/usr/bin/env zsh
#--------------------------------------------
# file:     ~/.zsh.d/prompt
# author:   Mike Redd
# version:  1.3
# desc:     Arakiel prompt with SSH + Git context
#--------------------------------------------

setopt PROMPT_SUBST

# ── Git branch helper ──────────────────────
_arakiel_git_branch() {
    local branch dirty

    branch=$(command git branch --show-current 2>/dev/null) || return 0
    [[ -n "$branch" ]] || return 0

    dirty=$(command git status --porcelain 2>/dev/null | command wc -l)
    dirty=${dirty//[[:space:]]/}

    if [[ -n "$dirty" && "$dirty" -gt 0 ]]; then
        printf ' (%s*%s)' "$branch" "$dirty"
    else
        printf ' (%s)' "$branch"
    fi
}

# ── Prompt ─────────────────────────────────
if [[ -n "$SSH_CLIENT" || -n "$SSH_TTY" ]]; then
    # SSH session
    PROMPT='%F{14}┌─[%F{9}SSH%F{14}]-[%F{10}%n@%m %F{7}%1~%F{14}$(_arakiel_git_branch)%F{14}]
%F{14}└─╼%f '
else
    # Local session
    PROMPT='%F{14}┌─[%F{10}%n@%m %F{7}%1~%F{14}$(_arakiel_git_branch)%F{14}]
%F{14}└─╼%f '
fi
