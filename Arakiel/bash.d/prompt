# ── Git branch helper ──────────────────────
_arakiel_git_branch() {
    local branch dirty

    branch=$(command git branch --show-current 2>/dev/null) || return 0
    [[ -n "$branch" ]] || return 0

    dirty=$(command git status --porcelain 2>/dev/null | command wc -l)
    dirty=${dirty//[[:space:]]/}

    if [[ -n "$dirty" && "$dirty" -gt 0 ]]; then
        printf ' (%s*%s)' "$branch" "$dirty"
    else
        printf ' (%s)' "$branch"
    fi
}

# ── ThemeEngine palette ─────────────────────
LIB_DIR="${LIB_DIR:-$HOME/lib}"
if [[ -f "$LIB_DIR/ui.sh" ]]; then
    # shellcheck source=/dev/null
    source <(sed 's/\r$//' "$LIB_DIR/ui.sh")
fi

PROMPT_FRAME="${UI_CYN:-$'\e[0;96m'}"
PROMPT_SSH="${UI_RED:-$'\e[0;31m'}"
PROMPT_HOST="${UI_GRN:-$'\e[0;92m'}"
PROMPT_PATH="${UI_TEXT:-${UI_WHT:-$'\e[0;37m'}}"
PROMPT_RESET="${UI_RST:-$'\e[0m'}"

# ── Prompt ─────────────────────────────────
if [[ -n "${SSH_CLIENT:-}" || -n "${SSH_TTY:-}" ]]; then
    # SSH session
    PS1="\[${PROMPT_FRAME}\]┌─[\[${PROMPT_SSH}\]SSH\[${PROMPT_FRAME}\]]-[\[${PROMPT_HOST}\]\u@\h \[${PROMPT_PATH}\]\W\[${PROMPT_FRAME}\]\$(_arakiel_git_branch)\[${PROMPT_FRAME}\]]\n\[${PROMPT_FRAME}\]└─╼\[${PROMPT_RESET}\] "
else
    # Local session
    PS1="\[${PROMPT_FRAME}\]┌─[\[${PROMPT_HOST}\]\u@\h \[${PROMPT_PATH}\]\W\[${PROMPT_FRAME}\]\$(_arakiel_git_branch)\[${PROMPT_FRAME}\]]\n\[${PROMPT_FRAME}\]└─╼\[${PROMPT_RESET}\] "
fi

unset PROMPT_FRAME PROMPT_SSH PROMPT_HOST PROMPT_PATH PROMPT_RESET
