# ── Git branch helper ──────────────────────
_arakiel_git_branch() {
    local branch

    branch=$(command git branch --show-current 2>/dev/null) || return 0
    [[ -n "$branch" ]] && printf ' (%s)' "$branch"
}

# ── Prompt ─────────────────────────────────
if [[ -n "$SSH_CLIENT" || -n "$SSH_TTY" ]]; then
    # SSH session
    PS1='\[\e[0;96m\]┌─[\[\e[0;31m\]SSH\[\e[0;96m\]]-[\[\e[0;92m\]\u@\h \[\e[0;37m\]\W\[\e[0;96m\]$(_arakiel_git_branch)\[\e[0;96m\]]\n\[\e[0;96m\]└─╼\[\e[0m\] '
else
    # Local session
    PS1='\[\e[0;96m\]┌─[\[\e[0;92m\]\u@\h \[\e[0;37m\]\W\[\e[0;96m\]$(_arakiel_git_branch)\[\e[0;96m\]]\n\[\e[0;96m\]└─╼\[\e[0m\] '
fi
