#!/usr/bin/env bash
#--------------------------------------------
# file:     ~/.bash.d/motd
# author:   Mike Redd
# version:  3.0
# desc:     Bash loader for the shared Arakiel SSH MOTD renderer
#--------------------------------------------

# Keep shell-specific startup files tiny. The renderer itself is shared with Zsh
# so Bash and Zsh cannot silently drift into separate MOTD implementations.
if [[ -r "$HOME/lib/motd.sh" ]]; then
    # shellcheck source=/dev/null
    source "$HOME/lib/motd.sh"
fi
